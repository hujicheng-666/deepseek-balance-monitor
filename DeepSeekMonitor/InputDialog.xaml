<Window x:Class="DeepSeekMonitor.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        Background="#FDF8FF">
    <StackPanel Margin="22,18">
        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="#5C4A6D"
                   MaxWidth="320"
                   Margin="0,0,0,14"/>
        <PasswordBox x:Name="KeyBox" Height="30" FontSize="13" Padding="6,2"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="78" Height="30" Margin="0,0,8,0"
                    Background="#FFFFFF" Foreground="#5C4A6D" BorderBrush="#E9D9F6"
                    Click="Cancel_Click"/>
            <Button Content="保存" Width="78" Height="30" IsDefault="True"
                    Background="#8A6FE8" Foreground="#FFFFFF" BorderThickness="0"
                    Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
